<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sample plugin. Place the built DLL and its adjacent template.json in the user templates directory; see docs/PLUGINS.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WheelPluginSample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against Orbit.Wheel; don't ship a copy of the application assembly with the plugin. -->
    <ProjectReference Include="..\..\Orbit.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="template.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

