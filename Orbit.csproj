<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Orbit</AssemblyName>
    <RootNamespace>Orbit</RootNamespace>
    <Product>Orbit</Product>
    <Version>1.1.0</Version>
    <ApplicationIcon>resources\Brand\orbit.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="src\Application\App.xaml" />
    <ApplicationDefinition Include="src\Application\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Samples for template authors build on their own -->
    <Compile Remove="samples\**" />
    <None Remove="samples\**" />
    <Page Remove="samples\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window/taskbar icon (pack URI) and a loose copy for the tray, which loads it at the exact DPI size -->
    <Resource Include="resources\Brand\orbit.png" />
    <Resource Include="resources\Brand\orbit.ico" />
    <None Include="resources\Brand\orbit.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Both assets are embedded so single-file builds retain the same UI and feedback. -->
    <Resource Include="resources\Fonts\Anton-Regular.ttf" />
    <Resource Include="resources\Audio\click_audio.wav" />
    <None Include="resources\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="COPYRIGHT" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The direct-download single-file executable also carries the notices. -->
    <EmbeddedResource Include="LICENSE" LogicalName="Orbit.Notices.LICENSE" />
    <EmbeddedResource Include="COPYRIGHT" LogicalName="Orbit.Notices.COPYRIGHT" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="Orbit.Notices.THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="resources\Fonts\OFL.txt" LogicalName="Orbit.Notices.Anton-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Pinned: 6.2.4 is the last MIT release. 6.5.0+ is AGPL-3.0 and requires a license key. Do not upgrade. -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="SharpCompress" Version="0.50.6" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
